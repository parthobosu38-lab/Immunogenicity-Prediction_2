cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "Peptide T-Cell Epitope Immunogenicity Prediction Pipeline"
version: "1.0.0"
date-released: "2026-09-04"
authors:
  - family-names: "Partho Bosu"
    given-names: "Partho"
    affiliation: "NIT Durgapur"
    # orcid: "https://orcid.org/0009-0008-3201-1595"
